# Add to /etc/caddy/Caddyfile on elmer, then run: sudo systemctl reload caddy
# Cache headers are set by the app (server.ts): hashed assets forever, HTML and /api never.
#
# The global options block needs Cloudflare's ranges as trusted proxies so the app sees the
# real client address in X-Forwarded-For (used for login rate limiting). Refresh the list
# from https://www.cloudflare.com/ips/ now and then.
#
# {
# 	servers {
# 		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
# 	}
# }

bikeboi.hlekkir.is {
	encode zstd gzip

	# the API is per-user and must never be cached by Cloudflare or a browser
	@api path /api/*
	header @api Cache-Control "no-store"
	request_body @api {
		max_size 3MB
	}

	reverse_proxy 127.0.0.1:3070
}
