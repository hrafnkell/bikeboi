# systemd user service, installed to ~/.config/systemd/user/ by deploy/deploy.sh
[Unit]
Description=bikeboi (side-scrolling trainer game)
After=network-online.target

[Service]
WorkingDirectory=%h/srv/bikeboi
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3070
# Optional: override settings without editing this file
EnvironmentFile=-%h/srv/bikeboi/.env
ExecStart=%h/.bun/bin/bun run server.ts
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
