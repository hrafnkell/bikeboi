{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "bun",
      "web-bluetooth",
      "vite/client"
    ],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": false,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "src",
    "src/**/*.vue",
    "test",
    "server.ts",
    "vite.config.ts"
  ],
  "exclude": [
    "src/vendor"
  ]
}
